# LexFusion — Streamlit Cloud Secrets Template
# =============================================
# In Streamlit Cloud: go to App Settings → Secrets
# and paste the content below (without the # comments).
#
# DO NOT commit your actual secrets.toml to GitHub.

GROQ_API_KEY = "gsk_your_actual_groq_key_here"

# Optional overrides (sensible defaults are built-in)
# GROQ_MODEL = "llama-3.3-70b-versatile"
# LLM_TEMPERATURE = "0.3"
# MAX_DEBATE_ROUNDS = "2"
