# LexFusion — Environment Variables
# ====================================
# Copy this file to .env and fill in your values.
# For Streamlit Cloud: add these in the Secrets panel (not this file).

# ── Required ─────────────────────────────────────────────────
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Optional: Model Configuration ────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
MAX_DEBATE_ROUNDS=2

# ── Optional: FastAPI Server (local deployment only) ─────────
# Only needed if running backend/main.py as a separate server
LEXFUSION_API_URL=http://localhost:8000
